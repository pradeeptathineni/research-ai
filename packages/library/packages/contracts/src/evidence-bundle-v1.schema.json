{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-ai.local/contracts/evidence-bundle-v1.schema.json",
  "title": "Signals evidence bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "mode", "created_at", "producer", "need", "sources", "claims", "candidates", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "bundle_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["agent-assisted", "model-led", "offline-curated", "fixture"]},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "protocol"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 7},
        "protocol": {"type": "string", "minLength": 1}
      }
    },
    "need": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query"],
      "properties": {
        "query": {"type": "string", "minLength": 1},
        "concept_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "constraints": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "uri", "title", "source_class"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "format": "uri"},
          "title": {"type": "string", "minLength": 1},
          "source_class": {"type": "string", "minLength": 1},
          "observed_at": {"type": ["string", "null"], "format": "date-time"},
          "revision": {"type": ["string", "null"]},
          "independence_group": {"type": ["string", "null"]}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "source_ids", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "status": {"enum": ["observed", "supported", "inferred", "uncertain", "contradicted"]}
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "canonical_uri", "claim_ids", "disposition", "reason", "limitations"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "canonical_uri": {"type": "string", "format": "uri"},
          "claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "disposition": {"enum": ["consider", "trial", "adopt", "defer", "reject"]},
          "reason": {"type": "string", "minLength": 1},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "signal": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "evidence_confidence": {"enum": ["low", "medium", "high", "unknown"]},
              "project_fit": {"enum": ["low", "medium", "high", "unknown"]}
            }
          }
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "extensions": {"type": "object", "additionalProperties": true}
  }
}
