{
  "name": "@pradeeptathineni/research-ai",
  "version": "0.4.0-rc.1",
  "description": "Bounded, read-only, ephemeral Codex research sessions: a small CLI and API returning fallible research with receipts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pradeeptathineni/research-ai.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "bin": {
    "research-ai": "bin/research-ai.mjs",
    "research-report-export": "bin/research-report-export.mjs",
    "research-bibliography": "bin/research-bibliography.mjs",
    "research-branches": "bin/research-branches.mjs",
    "research-table-analysis": "bin/research-table-analysis.mjs",
    "research-table-csv": "bin/research-table-csv.mjs"
  },
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README.md",
    "ARCHITECTURE.md",
    "docs/compatibility.md",
    "docs/SurfSense-LICENSE.txt",
    "docs/report-export.md",
    "src/bibliography-NOTICE.txt",
    "src/bibliography-MIT-LICENSE.txt",
    "docs/bibliography.md",
    "docs/independent-branches.md",
    "docs/table-analysis.md",
    "docs/table-csv.md"
  ],
  "scripts": {
    "cli": "node bin/research-ai.mjs",
    "test": "node --test --test-concurrency=1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "6.0.3"
  }
}
