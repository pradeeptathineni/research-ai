{
  "name": "@pradeeptathineni/research-ai",
  "version": "0.4.0-rc.1",
  "description": "Bounded, read-only, ephemeral Codex research sessions: a small CLI and API returning fallible research with receipts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pradeeptathineni/research-ai.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "bin": {
    "research-ai": "bin/research-ai.mjs",
    "research-report-export": "bin/research-report-export.mjs",
    "research-bibliography": "bin/research-bibliography.mjs",
    "research-branches": "bin/research-branches.mjs",
    "research-table-analysis": "bin/research-table-analysis.mjs",
    "research-table-csv": "bin/research-table-csv.mjs",
    "research-documents": "bin/research-documents.mjs",
    "research-table-query": "bin/research-table-query.mjs",
    "research-notebook": "bin/research-notebook.mjs",
    "research-notebook-search": "bin/research-notebook-search.mjs",
    "research-study": "bin/research-study.mjs",
    "research-perspective-workflow": "bin/research-perspective-workflow.mjs",
    "research-document-recovery": "bin/research-document-recovery.mjs",
    "research-document-recovery-synthesis": "bin/research-document-recovery-synthesis.mjs",
    "research-table-notebook": "bin/research-table-notebook.mjs"
  },
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README.md",
    "ARCHITECTURE.md",
    "docs/compatibility.md",
    "docs/SurfSense-LICENSE.txt",
    "docs/report-export.md",
    "src/bibliography-NOTICE.txt",
    "src/bibliography-MIT-LICENSE.txt",
    "docs/bibliography.md",
    "docs/independent-branches.md",
    "docs/table-analysis.md",
    "docs/table-csv.md",
    "docs/document-research.md",
    "docs/document-coverage.md",
    "docs/table-query.md",
    "docs/notebook.md",
    "src/notebook-MIT-LICENSE.txt",
    "src/notebook-NOTICE.txt",
    "docs/notebook-search.md",
    "src/notebook-search-NOTICE.txt",
    "src/vendor/minisearch-7.2.0.mjs",
    "src/vendor/minisearch-LICENSE.txt",
    "docs/research-study.md",
    "docs/literature-set.md",
    "docs/perspective-workflow.md",
    "docs/document-recovery.md",
    "docs/document-recovery-synthesis.md",
    "bin/research-table-notebook.mjs",
    "docs/table-notebook.md"
  ],
  "scripts": {
    "cli": "node bin/research-ai.mjs",
    "test": "node --test --test-concurrency=1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "6.0.3"
  }
}
